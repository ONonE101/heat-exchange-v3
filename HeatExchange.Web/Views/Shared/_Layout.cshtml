<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Расчёт стационарного теплообмена окатышей и воздуха в противотоке. Вариант 3." />
    <title>@ViewData["Title"] · Теплообмен</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" asp-controller="Calculator" asp-action="Index"><span class="brand-mark" aria-hidden="true">↕</span>Теплообмен<span class="variant-badge">Вариант 3</span></a>
        <nav aria-label="Основная навигация">
            <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")" asp-controller="Calculator" asp-action="Index">Расчёт</a>
            <a class="@(ViewContext.RouteData.Values["action"]?.ToString() == "Saved" ? "active" : "")" asp-controller="Calculator" asp-action="Saved">Сохранённые варианты</a>
        </nav>
    </header>
    <main class="page-shell">@RenderBody()</main>
    <footer class="site-footer"><span>Моделирование процессов и систем в металлургии</span><span>Шарапов Д. С. · НМТ-343901</span></footer>
    <script src="~/js/site.js" asp-append-version="true" defer></script>
</body>
</html>
