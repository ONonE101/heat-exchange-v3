@model ErrorViewModel
@{
    ViewData["Title"] = "Ошибка приложения";
}

<section class="empty-state">
<h1>Не удалось выполнить запрос</h1>
<p>Вернитесь к расчёту и повторите действие. Если ошибка повторяется, проверьте доступ к папке App_Data и журнал приложения.</p>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Номер запроса:</strong> <code>@Model.RequestId</code>
    </p>
}

<a class="button primary" asp-controller="Calculator" asp-action="Index">Вернуться к расчёту</a>
</section>
